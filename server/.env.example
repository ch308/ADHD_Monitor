# 复制为 ~/.config/adhd-monitor.env 并填入真实值，权限设为 600
# cp server/.env.example ~/.config/adhd-monitor.env
# chmod 600 ~/.config/adhd-monitor.env

MOONSHOT_API_KEY=请填入Moonshot控制台生成的key

# 小米手环 6 BLE 鉴权密钥（32 位十六进制，与 Gadgetbridge / 设备详情 authKey 一致）。
# 写入后，已登录 App 可通过 GET /my/config/xiaomi-band-auth-key 拉取（勿在公网暴露未鉴权接口）。
# XIAOMI_AUTH_KEY=0123456789abcdef0123456789abcdef

# 可选项
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# 单次建议 + 星星机器人脚本（默认 kimi-k2.5）
# MOONSHOT_CHAT_MODEL=kimi-k2.5
# 周报模型（默认 kimi-k2.5）
# WEEKLY_REPORT_MODEL=kimi-k2.5
# Kimi 默认关闭「思考」模式（响应更快）；若要开启思考：MOONSHOT_ENABLE_THINKING=1
# 可选：用 JSON 覆盖/追加 extra_body 字段（与默认 thinking 合并）
# MOONSHOT_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}
# 兼容旧变量：MOONSHOT_DISABLE_THINKING=0 等价于开启思考
# WEEKLY_REPORT_SECRET=
# 设备绑定管理页 /admin/device-bindings?token=... 的独立管理口令。
# 不设置时该页面返回 503；若留空但设置了 WEEKLY_REPORT_SECRET，会复用 WEEKLY_REPORT_SECRET。
# DEVICE_BIND_ADMIN_TOKEN=请填入一串随机长口令
# CHILD_DISPLAY_NAME=孩子
# DISABLE_WEEKLY_SCHEDULER=

# ── Path A：小智 xiaozhi-esp32 自建 WebSocket（不再使用 OTA） ──
# 设备端通过固件 menuconfig 中的 ADHD_MONITOR_WS_URL / WS_TOKEN 启动时直接写入
# NVS websocket 配置，本服务只暴露 /xiaozhi/ws，不再提供 /xiaozhi/ota。
#
# 设备端 Authorization 头校验：与固件 menuconfig 里的 ADHD_MONITOR_WS_TOKEN 一致；
# 留空则跳过校验（仅供闭环测试，不建议生产环境）。
# XIAOZHI_WEBSOCKET_TOKEN=
#
# 语音识别（上行用户语音→文字）：百度短语音识别标准版
#   控制台：https://console.bce.baidu.com/ai/  →  应用列表里取 API Key / Secret Key
#   文档：  https://cloud.baidu.com/doc/SPEECH/s/Jlbxdezuf
BAIDU_SPEECH_API_KEY=请填入百度AI控制台应用的API_Key
BAIDU_SPEECH_SECRET_KEY=请填入百度AI控制台应用的Secret_Key
# 可选：识别模型 dev_pid（默认 1537=普通话；1737=英语；1637=粤语；1837=四川话）
# BAIDU_SPEECH_DEV_PID=1537
# 可选：百度文档建议传机器唯一标识（默认 adhd-monitor-server，便于在控制台区分调用源）
# BAIDU_SPEECH_CUID=
#
# TTS 音色（edge-tts，仅自建 /xiaozhi/ws 路径使用）
# XIAOZHI_TTS_VOICE=zh-CN-XiaoxiaoNeural
# Kimi 对话模型（默认 kimi-k2.5，与 MOONSHOT_CHAT_MODEL 一致即可）
# XIAOZHI_CHAT_MODEL=kimi-k2.5
# 家长 submit_log 后小智主动开口的默认引导语
# XIAOZHI_DEFAULT_OPENING=
