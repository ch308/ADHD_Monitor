# 复制为 ~/.config/adhd-monitor.env 并填入真实值，权限设为 600
# cp server/.env.example ~/.config/adhd-monitor.env
# chmod 600 ~/.config/adhd-monitor.env

MOONSHOT_API_KEY=请填入Moonshot控制台生成的key

# 可选项
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# WEEKLY_REPORT_MODEL=moonshot-v1-8k
# WEEKLY_REPORT_SECRET=
# CHILD_DISPLAY_NAME=孩子
# DISABLE_WEEKLY_SCHEDULER=

# ── Path A：小智 xiaozhi-esp32 自建 WebSocket / OTA（需公网可访问的 wss）──
# 公网根 URL（不要尾斜杠）。用于自动生成 wss://…/xiaozhi/ws 与 https://…/xiaozhi/ota
# ADHD_PUBLIC_BASE_URL=https://你的域名:11760
# 或直接写完整地址（优先级更高）：
# XIAOZHI_WEBSOCKET_URL=wss://你的域名:11760/xiaozhi/ws
# XIAOZHI_OTA_URL=https://你的域名:11760/xiaozhi/ota
# 设备端 Authorization 头校验用（与固件 NVS token 对齐；不设则默认 adhd-local-token）
# XIAOZHI_WEBSOCKET_TOKEN=
# 语音识别（用户语音→文字）：OpenAI Whisper 官方 API（与 Kimi 分离）
# OPENAI_API_KEY=
# TTS 音色（edge-tts）
# XIAOZHI_TTS_VOICE=zh-CN-XiaoxiaoNeural
# Kimi 对话模型
# XIAOZHI_CHAT_MODEL=moonshot-v1-8k
# 家长 submit_log 后小智主动开口的默认引导语
# XIAOZHI_DEFAULT_OPENING=
