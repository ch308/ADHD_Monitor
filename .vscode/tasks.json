{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP-IDF: Build only",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd /d ${workspaceFolder}\\ESP32-S3-LCD-1.47B && call \"C:\\esp\\v6.0.1\\esp-idf\\export.bat\" && idf.py set-target esp32s3 && idf.py build"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "ESP-IDF: Build & Flash",
            "type": "shell",
            "command": "cmd",
            "group": {
                "kind": "build"
            },
            "args": [
                "/c",
                "cd /d ${workspaceFolder}\\ESP32-S3-LCD-1.47B && call \"C:\\esp\\v6.0.1\\esp-idf\\export.bat\" && idf.py set-target esp32s3 && idf.py build && idf.py -p ${input:serialPort} flash"
            ],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "ESP-IDF: Flash only (no build)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd /d ${workspaceFolder}\\ESP32-S3-LCD-1.47B && call \"C:\\esp\\v6.0.1\\esp-idf\\export.bat\" && idf.py -p ${input:serialPort} flash"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "ESP-IDF: Monitor",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd /d ${workspaceFolder}\\ESP32-S3-LCD-1.47B && call \"C:\\esp\\v6.0.1\\esp-idf\\export.bat\" && idf.py -p ${input:serialPort} monitor"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "ESP-IDF: Full (Build, Flash, Monitor)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd /d ${workspaceFolder}\\ESP32-S3-LCD-1.47B && call \"C:\\esp\\v6.0.1\\esp-idf\\export.bat\" && idf.py set-target esp32s3 && idf.py build && idf.py -p ${input:serialPort} flash && idf.py -p ${input:serialPort} monitor"
            ],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "ESP-IDF: Clean build",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "cd /d ${workspaceFolder}\\ESP32-S3-LCD-1.47B && call \"C:\\esp\\v6.0.1\\esp-idf\\export.bat\" && idf.py fullclean && idf.py set-target esp32s3 && idf.py build"
            ],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "serialPort",
            "type": "promptString",
            "description": "ESP32-S3 serial port",
            "default": "COM4"
        }
    ]
}
