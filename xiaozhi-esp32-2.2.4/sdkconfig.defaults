CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024
CONFIG_COMPILER_CXX_RTTI=y

CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=2048

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y

# These entries are copied from ESP-HI (ESP32C3) to reduce memory usage
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Fix ML307 FIFO Overflow
CONFIG_UART_ISR_IN_IRAM=y

# Fix ESP_SSL error
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n

# LVGL 9.2.2

CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_USE_ASSERT_STYLE=y

# Use compressed font
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=n
CONFIG_LV_USE_FONT_PLACEHOLDER=n
CONFIG_LV_USE_LODEPNG=y

# Disable extra widgets to save flash size
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CALENDAR_HEADER_ARROW=n
CONFIG_LV_USE_CALENDAR_HEADER_DROPDOWN=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n

CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# Hardware: 星智 CUBE 1.54 TFT WiFi 版。
# Keep this in defaults so a fresh `idf.py reconfigure` does not fall back to
# BOARD_TYPE_BREAD_COMPACT_WIFI, which drives an I2C OLED instead of this SPI TFT.
CONFIG_BOARD_TYPE_XINGZHI_CUBE_1_54TFT_WIFI=y

# ADHD Monitor 星星机器人 BLE WiFi provisioning (Path A).
# Without these the firmware silently falls back to USE_HOTSPOT_WIFI_PROVISIONING
# (its Kconfig default), the BLE branch in wifi_board.cc never compiles, and
# the Flutter app cannot find any "XIAOZHI_<MAC>" advertisement.
# CONFIG_USE_HOTSPOT_WIFI_PROVISIONING is not set
CONFIG_USE_ADHD_BLE_WIFI_PROVISIONING=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=y

# ADHD Monitor 云端集成（Path A）。Without these the firmware connects to
# the upstream xiaozhi cloud (api.tenclass.net / mqtt.xiaozhi.me) and never
# announces to our Flask server, so cloudService.bindEsp32(...) on the Flutter
# side can never resolve the device after BLE provisioning.
#   CMD_HOST/PORT  → POST /device/esp32/announce + long-poll /device/<id>/cmd
#   BYPASS_OTA=y   → skip xiaozhi's OTA + activation, seed the websocket NVS
#                    namespace from the WS_URL/WS_TOKEN below at every boot.
#   WS_URL         → /xiaozhi/ws on the same Flask server (Kimi proxy)
CONFIG_ADHD_MONITOR_REMOTE_CMD=y
CONFIG_ADHD_MONITOR_CMD_HOST="124.223.53.33"
CONFIG_ADHD_MONITOR_CMD_PORT=11760
CONFIG_ADHD_MONITOR_BYPASS_OTA=y
CONFIG_ADHD_MONITOR_WS_URL="ws://124.223.53.33:11760/xiaozhi/ws"
CONFIG_ADHD_MONITOR_WS_TOKEN=""

# 星星机器人儿童友好屏幕：顶部欢迎语 + 中间状态 + 表情（不显示空闲时钟）
CONFIG_ADHD_KIDS_UI=y

