# 统一换行符：所有文本文件检出时使用 LF，提交时自动规范化
* text=auto eol=lf

# Markdown 强制 LF
*.md text eol=lf

# 源代码
*.dart text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.env text eol=lf
*.sh text eol=lf

# Windows 批处理脚本保留 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行符转换
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.opus binary
*.bin binary
*.elf binary
